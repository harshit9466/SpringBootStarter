<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.SpringBootStarter</groupId>
	<artifactId>SpringBootStarter</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>SpringBootStarter</name>
	<description>Fully configured Spring Boot Project</description>

    <build>
        <finalName>SpringBootStarter</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
	</parent>

	<dependencies>
		<!-- Spring Boot Starter for Data JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Spring Boot Actuator — exposes /actuator/* endpoints for health, metrics, info -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			micrometer-registry-prometheus
			Micrometer (built into Spring Boot) collects metrics internally.
			This dependency adds a Prometheus-compatible /actuator/prometheus endpoint
			that exposes all metrics in Prometheus text format — the format Prometheus
			server scrapes every 15s to store in its time-series database.
			Without this: metrics exist only in memory, Prometheus cannot reach them.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!--
			micrometer-tracing-bridge-otel
			Micrometer Tracing is Spring Boot 3's tracing facade (same role as Micrometer
			for metrics — decouples instrumentation code from the tracing backend).
			This bridge wires Micrometer Tracing's API to the OpenTelemetry implementation.
			Auto-instruments: every HTTP request/response, and propagates trace context
			(W3C traceparent header) to outbound RestTemplate/WebClient calls automatically.
			Without this: no spans are created, no traceId exists anywhere.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>

		<!--
			opentelemetry-exporter-otlp
			Exports finished spans to a tracing backend (Grafana Tempo here) using the
			OTLP protocol — the vendor-neutral standard most modern tracing backends accept.
			Without this: spans are created in-memory but never sent anywhere; Tempo stays empty.
		-->
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>

		<!-- Spring Boot Starter for Web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Security + OAuth2 Resource Server (Keycloak JWT validation via RS256 + JWK) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- H2 Database -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Structured JSON Logging for production log aggregation (Loki / Elasticsearch) -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>

		<!--
			loki-logback-appender (Module 7 — Logging Infrastructure)
			Pushes logs directly from this JVM to Grafana Loki over HTTP — no Promtail or
			file-tailing needed. Chosen specifically because this app runs on the HOST (not
			in Docker, see docker-compose.yml), so there's no container stdout for a
			cluster-level log collector to tail in this dev setup, same reasoning as using
			OTLP-over-HTTP directly for tracing instead of a sidecar collector.
			Third-party library, NOT covered by Spring Boot's dependency management —
			version verified against Maven Central (search.maven.org), not guessed.
			WHAT HAPPENS IF REMOVED: logs stay in console/file only, never reach Loki.
		-->
		<dependency>
			<groupId>com.github.loki4j</groupId>
			<artifactId>loki-logback-appender</artifactId>
			<version>2.0.0</version>
		</dependency>

		<!-- Add the Hibernate Validator dependency -->
		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!-- Testing Dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<properties>
		<java.version>21</java.version>
	</properties>
</project>
