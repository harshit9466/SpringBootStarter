<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         PROPERTY DEFINITIONS
         spring.application.name is set in application.properties
    ================================================================ -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>

    <!-- ================================================================
         DEV PROFILE — Human-readable console output
         Pattern includes: time | level (padded) | traceId | thread | logger | message
    ================================================================ -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!--
                    traceId/spanId: populated automatically by Micrometer Tracing (Module 8) —
                    no filter code sets these. Using :- (default-empty) instead of a bare %X{}
                    avoids the literal string "null" appearing on startup logs or background
                    threads where no HTTP request — and therefore no span — is active.
                -->
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(${APP_NAME})] [traceId=%X{traceId:-}] [spanId=%X{spanId:-}] [%thread] %logger{40} - %msg%n%ex
                </pattern>
            </encoder>
        </appender>

        <!--
            Module 7 (Logging Infrastructure) — pushes the SAME log stream to Loki over HTTP,
            in addition to the console. Direct push (not Promtail/file-tailing) because this
            app runs on the host, not in a container Promtail could read stdout from.

            labels: kept to ONLY "app" — labels are Loki's indexed fields, same high-cardinality
            rule as Prometheus tags from Module 4. traceId/spanId/requestId are unique per
            request — putting them here would blow up Loki's index exactly like a unique
            Prometheus tag value would.

            structuredMetadata: this is where traceId/spanId/requestId belong instead — still
            queryable/filterable per log line, without being part of the index.
        -->
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>http://localhost:3100/loki/api/v1/push</url>
            </http>
            <labels>
                app = ${APP_NAME}
            </labels>
            <structuredMetadata>
                level = %level
                traceId = %X{traceId:-}
                spanId = %X{spanId:-}
                requestId = %X{requestId:-}
            </structuredMetadata>
            <message>
                <pattern>[%thread] %logger{40} - %msg%n%ex</pattern>
            </message>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>

        <!-- Enable DEBUG for our own code only — not Spring internals -->
        <logger name="com.SpringBootStarter" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </logger>
    </springProfile>

    <!-- ================================================================
         PROD PROFILE — Structured JSON output for Loki / Elasticsearch
         Every log line is a valid JSON object.
         DevOps ingests this via Fluent Bit / Filebeat.
    ================================================================ -->
    <springProfile name="prod">

        <!-- Async wrapper: application thread puts event in queue and returns
             immediately. Background I/O thread drains queue and writes to file. -->
        <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>2048</queueSize>
            <!-- 0 = never silently drop logs even when queue is near full.
                 Default is 20 which drops INFO/DEBUG when queue is 80% full — dangerous during incidents. -->
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="JSON_FILE"/>
        </appender>

        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/${APP_NAME}.log</file>

            <!-- Daily rollover, keep 30 days, max 1GB total -->
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>

            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Add service name to every log line — critical for multi-service setups -->
                <customFields>{"service":"${APP_NAME}"}</customFields>

                <!-- Include MDC fields (traceId, citizenId, etc.) as top-level JSON fields -->
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>citizenId</includeMdcKeyName>
                <includeMdcKeyName>district</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>

        <!-- Suppress noisy Spring internal logs in prod -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate"       level="WARN"/>
        <logger name="com.zaxxer.hikari"   level="WARN"/>
    </springProfile>

</configuration>
